<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal device-admin policy. Being an *active* admin is what prevents
     uninstall; no intrusive policies are requested. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
